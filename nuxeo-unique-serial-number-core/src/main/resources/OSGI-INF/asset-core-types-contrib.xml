<?xml version="1.0" encoding="UTF-8"?>
<component name="io.maretha.asset.usn.core.types">

  <require>org.nuxeo.ecm.core.schema.TypeService</require>
  <require>org.nuxeo.ecm.core.CoreExtensions</require>

  <extension target="org.nuxeo.ecm.core.schema.TypeService" point="schema">
    <schema name="usn" prefix="usn" src="schemas/usn.xsd" />
  </extension>

  <extension target="org.nuxeo.ecm.core.schema.TypeService" point="doctype">
    <doctype name="Asset" extends="File">
      <schema name="usn" />
    </doctype>

    <doctype name="Workspace" append="true">
      <subtypes>
        <type>Asset</type>
      </subtypes>
    </doctype>
    <doctype name="Folder" append="true">
      <subtypes>
        <type>Asset</type>
      </subtypes>
    </doctype>
    <doctype name="OrderedFolder" append="true">
      <subtypes>
        <type>Asset</type>
      </subtypes>
    </doctype>
  </extension>

</component>
